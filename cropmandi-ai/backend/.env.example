# Application Configuration
APP_NAME="CropMandi AI"
ENV="development"
LOG_LEVEL="INFO"
SECRET_KEY="cropmandi-secret-key-change-in-production"

# Database Configuration
# For local dev without Postgres Docker: sqlite:///./cropmandi.db or postgresql://postgres:postgres@localhost:5432/cropmandi
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cropmandi"

# Official Data API (data.gov.in)
DATA_GOV_API_KEY="your_api_key_here"
DATA_GOV_RESOURCE_ID="/resource/35985678-0d79-46b4-9ed6-6f13308a1d24"
DATA_GOV_BASE_URL="https://api.data.gov.in"

# Weather API (Open-Meteo)
WEATHER_API_URL="https://api.open-meteo.com/v1"
WEATHER_HISTORICAL_API_URL="https://archive-api.open-meteo.com/v1"

# CORS Setup
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]
